{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": ".generated/scripts",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "incremental": false,
    "isolatedModules": false,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["scripts/**/*.ts", "domain/**/*.ts", "lib/**/*.ts"],
  "exclude": ["node_modules", ".next", "**/*.test.ts", "**/*.test.tsx"]
}

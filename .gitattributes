# Auto-detect text files and normalize line endings to LF
* text=auto

# Explicit LF for known text formats
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.env.example text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.eslintrc* text eol=lf

# Binary files — no line ending normalization
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary

# Generated / vendored — mark for linguist
*.lock linguist-generated=true
package-lock.json linguist-generated=true

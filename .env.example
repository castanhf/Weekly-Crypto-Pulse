# Site and payment (set in Vercel for Preview and Production)
STRIPE_PAYMENT_LINK_WEEKLY_PRO=
STRIPE_PAYMENT_LINK_MONTHLY_BUNDLE=
NEXT_PUBLIC_SITE_URL=https://weekly-crypto-pulse.com
NEXT_PUBLIC_X_HANDLE=@weeklycryptopulse

# Internal helpers (local dev only — leave unset in Production)
ENABLE_FULFILLMENT_ASSIST=
# Set to "true" to enable Vercel Analytics in development (disabled by default)
NEXT_PUBLIC_ANALYTICS_ENABLED=

# Pipeline (GitHub Actions / local)
# GITHUB_TOKEN is auto-injected in Actions; set to a PAT locally
GITHUB_TOKEN=
# Anthropic fallback for LLM calls when GitHub Models is unavailable.
# Optional but strongly recommended. Set a hard usage cap via prepaid credit at console.anthropic.com.
ANTHROPIC_API_KEY=

# Email distribution (Beehiiv) — added R2.1 (WCP-136)
# Required for read-side Beehiiv API calls (smoke test, subscriber management).
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# Enable programmatic email sends (daily digest, weekly, Sunday digest).
# Requires Beehiiv Enterprise tier (Send API). Default: disabled.
# See docs/operations/email-distribution.md for re-enabling paths.
BEEHIIV_BROADCAST_ENABLED=false
